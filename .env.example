# Credentials. Leave ANTHROPIC_API_KEY unset if you authenticate with
# `ant auth login` — a set (even empty) key shadows the profile.
ANTHROPIC_API_KEY=

# Model and reasoning depth.
AGENT_MODEL=claude-opus-5
AGENT_EFFORT=xhigh
AGENT_MAX_TOKENS=64000

# Where the file tools may read and write. Nothing outside this is reachable.
AGENT_WORKSPACE=./workspace

# Assistant turns allowed per user message.
AGENT_MAX_STEPS=24

# Hosted web tools.
AGENT_WEB_SEARCH=true
AGENT_WEB_FETCH=true
# AGENT_ALLOWED_DOMAINS=docs.python.org,platform.claude.com
# AGENT_BLOCKED_DOMAINS=example.com

# "summarized" streams reasoning summaries; "omitted" hides them.
AGENT_THINKING_DISPLAY=summarized

# Beta features. Disabled automatically if the API rejects them.
AGENT_COMPACTION=true
AGENT_REFUSAL_FALLBACKS=true
